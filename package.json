    "bootstrap": "^5.3.3",
    "bytes": "^3.1.2",
    "dbl-utils": "^1.0.12",
    "lzma": "^2.3.2"
  },
  "devDependencies": {
    "@babel/core": "^7.26.0",
    "@babel/preset-env": "^7.26.0",
    "@testing-library/dom": "^10.4.0",
